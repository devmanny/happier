{
  "manifest_version": 2,
  "name": "Happier Import",
  "version": "1.0",
  "description": "Copy cookies for the Safari page you choose into Happier on this device.",
  "permissions": [
    "activeTab",
    "cookies",
    "nativeMessaging"
  ],
  "optional_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Import into Happier",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_security_policy": "script-src 'self'; object-src 'none'; connect-src 'none'"
}
